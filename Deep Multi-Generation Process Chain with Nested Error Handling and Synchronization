#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/types.h>
int main()
{
   pid_t p2,p3,p4,p5,p6,p7,p8;
   p2=fork();
   if(p2<0){
      perror("Error");
   }
   else if(p2==0){
      p3=fork();
      if(p3<0){
         perror("Error");
      }
      else if(p3==0){
         p4=fork();
         if(p4<0){
            perror("Error");
         }
         else if(p4==0){
            p7=fork();
            if(p7<0){
               perror("Error");
            }
            else if(p7==0){
               p6=fork();
               if(p6<0){
                  perror("Error");
               }
               else if(p6==0){
                  p5=fork();
                  if(p5<0){
                     perror("Error");
                  }
                  else if(p5==0){
                     printf("P5: PID: %d\nParent PID: %d\n",getpid(),getppid());
                  }
                  else{
                     wait(NULL);
                     printf("P6: PID: %d\nParent PID: %d\n",getpid(),getppid());
                  }
               }
               else{
                  p8=fork();
                  if(p8<0){
                     perror("Error");
                  }
                  else if(p8==0){
                     printf("P8: PID: %d\nParent PID: %d\n",getpid(),getppid());
                  }
                  else{
                     wait(NULL);
                     wait(NULL);
                     printf("P7: PID: %d\nParent PID: %d\n",getpid(),getppid());
                  }
               }
            }
            else{
               wait(NULL);
               printf("P4: PID: %d\nParent PID: %d\n",getpid(),getppid());
            }
         }
         else{
            wait(NULL);
            printf("P3: PID: %d\nParent PID: %d\n",getpid(),getppid());
         }
      }
      else{
         wait(NULL);
         printf("P2: PID: %d\nParent PID: %d\n",getpid(),getppid());
      }
   }
   else{
      wait(NULL);
      printf("P1: PID: %d\n",getpid());
   }
   return 0;
}
