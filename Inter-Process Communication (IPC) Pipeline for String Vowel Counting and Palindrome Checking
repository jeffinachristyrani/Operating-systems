#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
#include<sys/types.h>
#include<string.h>
int main(){
   int fd1[2];
   int fd2[2];
   pid_t p1,p2,p3;
   if(pipe(fd1)==-1){
      printf("Pipe 1 failed.\n");
      return 1;
   }
   if(pipe(fd2)==-1){
      printf("Pipe 2 failed.\n");
      return 1;
   }
      p2=fork();
      if(p2<0){
         perror("Error");
      }
      else if(p2==0){
         char str[80];
         read(fd1[0],str,80);
         printf("String: %s\n",str);
         int i;
         int vowcount=0;
         for(i=0;str[i]!='\0';i++){
            if(str[i]=='a'||str[i]=='e'||str[i]=='i'||str[i]=='o'||str[i]=='u'||str[i]=='A'||str[i]=='E'||str[i]=='I'||str[i]=='O'||str[i]=='U'){
               vowcount++;
            }
         }
         printf("P2:\n");
         printf("Number of vowels: %d\n",vowcount);
         write(fd2[1],str,strlen(str)+1);
         p3=fork();
         if(p3<0){
            perror("Error");
            return 1;
         }
         else if(p3==0){
            char strr[80];
            read(fd2[0],strr,80);
            int i,len,flag=0;
            len=strlen(strr);
            for(i=0;i<len/2;i++){
               if(strr[i]!=strr[len-1-i]){
                  flag=1;
                  break;
               }
            }
            printf("P3: \n");
            if(flag){
               printf("The string is not a palindrome\n");
            }
            else{
               printf("The string is a palindrome\n");
            }
         }
         else{
              NULL;
         }
      }
      else{
         printf("P1: \n");
         char istr[80];
         printf("Enter your string: ");
         scanf("%s",istr);
         close(fd1[0]);
         write(fd1[1],istr,strlen(istr)+1);
         close(fd1[1]);
         wait(NULL);
      }
   return 1;
}
