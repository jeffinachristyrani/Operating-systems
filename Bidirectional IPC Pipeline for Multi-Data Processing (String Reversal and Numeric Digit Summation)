#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
#include<sys/types.h>
#include<string.h>

int main(){
   int fd1[2];
   int fd2[2];
   int fd3[2];
   int fd4[2];
   pid_t p2;
   if(pipe(fd1)==-1 || pipe(fd2)==-1 || pipe(fd3)==-1 || pipe(fd4)==-1){
      printf("Pipe failed.\n");
      return 1;
   }
   p2=fork();
   if(p2<0){
      perror("Error.\n");
      return 1;
   }
   else if(p2==0){
      char str[80];
      close(fd1[1]);
      read(fd1[0],str,80);
      close(fd1[0]);
      printf("Process P2:\n");
      printf("Entered string is: %s\n",str);
      int start=0,end=strlen(str)-1;
      while(start<end)
      {
        char temp=str[start];
        str[start]=str[end];
        str[end]=temp;
        start++;
        end--;
      }
      close(fd2[0]);
      write(fd2[1],str,strlen(str)+1);
      close(fd2[1]);
      int n;
      close(fd3[1]);
      read(fd3[0],&n,sizeof(n));
      close(fd3[0]);
      printf("Process P2: \n");
      printf("Entered number id: %d\n",n);
      int b=0;
      while(n!=0)
      {
         b+=n%10;
         n=n/10;
      }
      close(fd4[0]);
      write(fd4[1],&b,sizeof(b));
      close(fd4[1]);
   }
   else{
      printf("Process P1: \n");
      char strr[80];
      printf("Enter your string: ");
      scanf("%s",strr);
      close(fd1[0]);
      write(fd1[1],strr,strlen(strr)+1);
      close(fd1[1]);
      close(fd2[1]);
      read(fd2[0],strr,80);
      close(fd2[0]);
      printf("Reversed string: %s\n",strr);
      printf("Process P1:\n");
      printf("Enter the number: ");
      int n;
      scanf("%d",&n);
      close(fd3[0]);
      write(fd3[1],&n,sizeof(n));
      close(fd3[1]);
      wait(NULL);
      close(fd4[1]);
      read(fd4[0],&n,sizeof(n));
      close(fd4[0]);
      printf("Sum of digits is: %d\n",n);
   }
   return 0;
}
