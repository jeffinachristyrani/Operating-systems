#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/types.h>
#include <sys/wait.h>

#define ROWS 2
#define COLS 2

int i, j;

typedef struct {
    int mat1[ROWS*COLS];
    int mat2[ROWS*COLS];
} SharedData;

// FIXED: Changed parameter type from 2D array to 1D array to match your struct data
void printMatrix(int mat[ROWS*COLS]) {
    for (i = 0; i < ROWS*COLS; i++) {
        printf("%d ", mat[i]);
    }
    printf("\n"); // Visual separation
}

int main() {
    int shmid = shmget(IPC_PRIVATE, sizeof(SharedData), IPC_CREAT | 0666);
    if (shmid == -1) {
        perror("shmget failed");
        return 1;
    }

    SharedData *shared_mem = (SharedData *)shmat(shmid, NULL, 0);
    if (shared_mem == (void *)-1) {
        perror("shmat failed");
        return 1;
    }

    pid_t pid = fork();
    if (pid < 0) {
        perror("fork failed");
        return 1;
    }
    else if (pid > 0) {
        printf("[Parent] Enter elements for Matrix 1 (%dx%d):\n", ROWS, COLS);
        for (i = 0; i < ROWS*COLS; i++) {
            scanf("%d", &shared_mem->mat1[i]);
        }

        printf("[Parent] Enter elements for Matrix 2 (%dx%d):\n", ROWS, COLS);
        for (i = 0; i < ROWS*COLS; i++) {
            scanf("%d", &shared_mem->mat2[i]);
        }

        printf("[Parent] Matrices written to shared memory. Waiting for child...\n");
        wait(NULL);
        shmdt(shared_mem);
        shmctl(shmid, IPC_RMID, NULL);
        printf("[Parent] Shared memory destroyed. Exiting.\n");
    }
    else {
        sleep(5);
        printf("\n[Child] Reading matrices from shared memory...\n");

        printf("[Child] Matrix 1:\n");
        printMatrix(shared_mem->mat1);

        printf("[Child] Matrix 2:\n");
        printMatrix(shared_mem->mat2);

        printf("[Child] Resulting Sum Matrix:\n");
        // FIXED: Changed variable 'j' to 'i' inside the loop to resolve undefined behavior
        for (i = 0; i < ROWS*COLS; i++) {
            int sum = shared_mem->mat1[i] + shared_mem->mat2[i];
            printf("%d ", sum);
        }
        printf("\n");

        shmdt(shared_mem);
        exit(0);
    }
    return 0;
}
