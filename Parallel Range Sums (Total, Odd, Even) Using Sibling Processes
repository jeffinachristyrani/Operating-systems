#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int sumofnum(int n){
   int i=0,sum=0;
   for(i=0;i<=n;i++){
      sum+=i;
   }
   return sum;
}

int sumofoddnum(int n){
   int i=0,sum=0;
   for(i=0;i<=n;i++){
      if(i%2!=0){
         sum+=i;
      }
   }
   return sum;
}

int sumofevennum(int n){
   int i=0,sum=0;
   for(i=0;i<=n;i++){
      if(i%2==0){
         sum+=i;
      }
   }
   return sum;
}

int main(){
   int n;
   printf("Enter the number n: ");
   scanf("%d", &n);
   pid_t pid1,pid2;
   pid1=fork();
   if(pid1==0){
      printf("\nProcess P2: \nSum of odd numbers in the range 0 to %d: ",n);
      int m=sumofoddnum(n);
      printf("%d\n",m);
   }
   else{
      pid2=fork();
      if(pid2==0){
         printf("\nProcess P3: \nSum of even numbers in the range 0 to %d: ",n);
         int m=sumofevennum(n);
         printf(" %d\n",m);
      }
      else{
         wait(NULL);
         printf("\nParent process P1: \nSum of numbers in the range 0 to %d: ",n);
         int m=sumofnum(n);
         printf("%d\n",m);
      }
   }
   return 0;
}
