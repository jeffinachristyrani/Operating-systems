#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t p2, p3, p4, p6, p7, p8;
    p2 = fork();
    if (p2 == 0)
    {
        p4 = fork();
        if (p4 == 0)
        {
            p6 = fork();
            if (p6 == 0)
            {
                printf("P6 : PID = %d, Parent = %d\n", getpid(), getppid());
            }
            else
            {
                wait(NULL);
                printf("P4 : PID = %d, Parent = %d\n", getpid(), getppid());
            }
        }
        else
        {
            wait(NULL);
            printf("P2 : PID = %d, Parent = %d\n", getpid(), getppid());
        }
    }
    else
    {
        p3 = fork();
        if (p3 == 0)
        {
            p7 = fork();

            if (p7 == 0)
            {
                printf("P7 : PID = %d, Parent = %d\n", getpid(), getppid());
            }
            else
            {
                wait(NULL);
                p8 = fork();
                if (p8 == 0)
                {
                    printf("P8 : PID = %d, Parent = %d\n", getpid(), getppid());
                }
                else
                {
                    wait(NULL);
                    printf("P3 : PID = %d, Parent = %d\n", getpid(), getppid());
                }
            }
        }
        else
        {
            wait(NULL);
            wait(NULL);
            printf("P1 : PID = %d\n", getpid());
        }
    }
    return 0;
}
