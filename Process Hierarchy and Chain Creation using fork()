#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
int main()
{
    pid_t pid1, pid2;
    pid1 = fork();
    if (pid1 == 0)
    {
        printf("P2:\nPID: %d\nParent PID: %d\n\n", getpid(), getppid());
        pid2 = fork();
        if (pid2 == 0)
        {
           wait(NULL);
            printf("P3:\nPID: %d\nParent PID: %d\n\n", getpid(), getppid());
        }
    }
    else
    {
       wait(NULL);
        printf("\nP1:\nPID: %d \nParent PID: %d\n\n", getpid(),getppid());
    }
    return 0;
}
